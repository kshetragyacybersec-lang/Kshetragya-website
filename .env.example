# Copy this file to .env.local for local development, and add the same
# keys in Vercel: Project Settings -> Environment Variables.
# .env / .env.local are already git-ignored by Vite's default .gitignore —
# never commit real secrets.

# --- Error monitoring (Sentry) ---------------------------------------------
# Free project at https://sentry.io -> Settings -> Client Keys (DSN).
# Safe no-op (nothing sent, no network calls) until this is set.
VITE_SENTRY_DSN=

# --- Spam protection (Cloudflare Turnstile) --------------------------------
# Free at https://dash.cloudflare.com/?to=/:account/turnstile
# Public site key goes in the frontend build:
VITE_TURNSTILE_SITE_KEY=
# Secret key stays server-side only, used by api/contact.js. Do NOT prefix
# this one with VITE_ — that would expose it in the client bundle.
TURNSTILE_SECRET_KEY=
